# Copy this file to `.env` and fill in what you need.

# --- Brain: NVIDIA NIM -------------------------------------------------------
# Same key you already use for the Claude Desktop FCC provider.
# Get one at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the endpoint if you self-host NIM or use a proxy.
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Optional: only used if stt.backend is set to "nim" in config.yaml -------
# Falls back to NVIDIA_API_KEY if unset.
# NIM_STT_API_KEY=

# --- Optional: enable web search tool ---------------------------------------
# BRAVE_API_KEY=
